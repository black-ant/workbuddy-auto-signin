[Unit]
Description=Qoder 每日 100 Credits 领取（首次 10:05~11:05 随机，白天兜底补领）

[Timer]
# 活动按北京时间 10:00 重置，首次触发须晚于 10:00（活动并非 10:00 准时下发，10:05 起点沿袭原设计）
# 每个触发点都在原点往后 1 小时内随机（首领 10:05~11:05，兜底 12:30~13:30 / 14:30~15:30 / 16:30~17:30）
OnCalendar=*-*-* 10:05:00
OnCalendar=*-*-* 12:30:00
OnCalendar=*-*-* 14:30:00
OnCalendar=*-*-* 16:30:00
Persistent=true
RandomizedDelaySec=1h
Unit=qoder-claim.service

[Install]
WantedBy=timers.target
